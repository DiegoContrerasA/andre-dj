---
import '@fontsource-variable/jetbrains-mono/wght.css';
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Andre's DJ" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Andre's DJ</title>
    <style is:global>
      :root {
        --bg: #0a0a0b; --card: #141416; --glass: #ffffff0d; --glass2: #ffffff17; --line: #ffffff12; --text: #f4f4f5;
        --muted: #8b8b93; --a: #7ee8b2; --b: #f06aa8; --warn: #f2c35b;
        --safe-t: env(safe-area-inset-top, 0px); --safe-b: env(safe-area-inset-bottom, 0px);
      }
      * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
      html, body { margin: 0; min-height: 100%; background: var(--bg); color: var(--text); font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; overscroll-behavior: none; }
      button { font: inherit; color: inherit; cursor: pointer; }

      /* ---------- Base ---------- */
      .aurora { display: none; }
      main { max-width: 560px; margin: 0 auto; padding: calc(16px + var(--safe-t)) 16px calc(16px + var(--safe-b)); display: grid; gap: 12px; }
      .mono { font-family: 'JetBrains Mono Variable', ui-monospace, 'SF Mono', Menlo, monospace; }

      /* ---------- Encabezado ---------- */
      header { display: flex; align-items: center; gap: 14px; padding: 2px 2px 0; }
      header h1 { font-size: 22px; margin: 0; flex: 1; font-weight: 700; letter-spacing: -.4px; }
      header h1 span { color: #8b8b93; font-weight: 600; }
      .live-ind { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; letter-spacing: 2px; color: #8b8b93; }
      .live-ind i { width: 7px; height: 7px; border-radius: 50%; background: #3a3a40; transition: background .3s, box-shadow .3s; }
      body.live .live-ind { color: #cfcfd4; }
      body.live .live-ind i { background: var(--a); box-shadow: 0 0 8px var(--a); animation: pulse 1.6s ease-in-out infinite; }
      @keyframes pulse { 50% { opacity: .45; } }

      /* ---------- Deck ---------- */
      .deck { --c: var(--a); position: relative; display: grid; align-content: center; gap: 10px; padding: 16px 16px 16px;
        border-radius: 22px; background: var(--card); border: 1px solid var(--line); transition: border-color .3s, box-shadow .3s; }
      .deck.b { --c: var(--b); }
      .deck { touch-action: manipulation; user-select: none; -webkit-user-select: none; } /* sin zoom ni selección al hacer doble toque */
      .deck::before { content: ''; position: absolute; top: -1px; left: 6%; right: 6%; height: 1px;
        background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--c) 75%, transparent), transparent); }
      .deck.playing { border-color: color-mix(in srgb, var(--c) 30%, var(--line)); box-shadow: 0 0 0 1px color-mix(in srgb, var(--c) 10%, transparent), 0 18px 50px -20px color-mix(in srgb, var(--c) 35%, transparent); }

      .deck-head { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 16px; align-items: center; }
      .vinyl { position: relative; aspect-ratio: 1; border-radius: 50%; border: 0; padding: 0;
        background:
          radial-gradient(circle, #0b0b0c 0 4%, var(--c) 5% 23%, transparent 23.5%),
          repeating-radial-gradient(circle, #19191c 0 1.5px, #0e0e10 1.5px 3px);
        box-shadow: 0 0 0 1px #000, 0 0 22px -2px color-mix(in srgb, var(--c) 45%, transparent);
        animation: spin var(--spin, 1.8s) linear infinite paused; transition: box-shadow .3s; }
      .vinyl::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from 30deg, #fff0, #ffffff10 6%, #fff0 14% 50%, #ffffff0a 56%, #fff0 64%); }
      .deck.playing .vinyl { animation-play-state: running; box-shadow: 0 0 0 1px #000, 0 0 30px 0 color-mix(in srgb, var(--c) 60%, transparent); }
      .deck.empty .vinyl { filter: saturate(.8); }
      @keyframes spin { to { transform: rotate(360deg); } }

      .meta { min-width: 0; display: grid; gap: 4px; }
      .top { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; min-width: 0; }
      .deck-id { flex: none; font-size: 12px; letter-spacing: 3px; color: var(--c); }
      .bpmtag { font-size: 12px; color: #8b8b93; white-space: nowrap; }
      .bpmtag b { color: var(--text); font-weight: 500; }
      .song { min-width: 0; }
      .song b { display: block; font-size: 17px; font-weight: 600; letter-spacing: -.2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .song small { display: block; color: #8b8b93; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 3px; }
      .shift { font-size: 11px; display: inline-flex; align-items: center; gap: 6px; color: #8b8b93; white-space: nowrap; min-height: 14px; }
      .shift i { width: 5px; height: 5px; border-radius: 50%; background: #3a3a40; }
      .shift.ok i { background: var(--a); } .shift.mid i { background: var(--warn); } .shift.bad i { background: var(--b); }

      .prog { position: relative; height: 18px; display: grid; align-items: center; touch-action: none; cursor: pointer; }
      .prog i { display: block; height: 2px; border-radius: 2px; background: linear-gradient(90deg, color-mix(in srgb, var(--c) 70%, transparent) var(--p, 0%), #ffffff14 var(--p, 0%)); }
      .prog::after { content: ''; position: absolute; top: 50%; left: var(--p, 0%); width: 12px; height: 12px; border-radius: 50%; background: #fff; transform: translate(-50%, -50%); box-shadow: 0 1px 4px #0008; }
      .deck.empty .prog::after { background: #d6d6da; }
      .time { display: flex; justify-content: space-between; font-size: 12px; color: #8b8b93; font-variant-numeric: tabular-nums; margin-top: -4px; }

      .time { align-items: center; }
      .skip { display: inline-flex; align-items: center; gap: 4px; height: 28px; padding: 0 10px; border-radius: 999px; border: 0; background: #1c1c1f; color: #b4b4bb; font-size: 11px; font-family: inherit; }
      .skip svg { width: 13px; height: 13px; }
      .skip:active { background: #26262a; color: #fff; }
      .deck.empty .skip { opacity: .4; }
      /* Feedback del doble toque (estilo YouTube) */
      .seek-fx { position: absolute; top: 50%; padding: 8px 14px; border-radius: 999px; background: #000c; color: #fff; font-size: 13px; pointer-events: none; opacity: 0; transform: translate(-50%, -50%) scale(.9); transition: opacity .25s, transform .25s; z-index: 2; }
      .seek-fx.show { opacity: 1; transform: translate(-50%, -50%) scale(1); transition: none; }
      .seek-fx.l { left: 25%; } .seek-fx.r { left: 75%; }
      .controls { display: flex; align-items: center; gap: 8px; min-width: 0; margin-top: 4px; }
      .disc { position: relative; flex: none; width: 76px; aspect-ratio: 1; padding: 0; border: 0; border-radius: 50%; background: none; display: grid; place-items: center; }
      .disc .vinyl { position: absolute; inset: 0; width: 100%; }
      .disc .pp { position: relative; z-index: 1; width: 40%; aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%;
        background: color-mix(in srgb, var(--c) 85%, #000); color: #0b0b0c; box-shadow: 0 2px 10px #0009, 0 0 0 3px #0b0b0c; transition: transform .1s, background .2s; }
      .disc .pp svg { width: 50%; height: 50%; }
      .deck.playing .disc .pp { background: var(--c); }
      .disc:disabled { cursor: default; }
      .disc:disabled .pp { background: color-mix(in srgb, var(--c) 35%, #1a1a1d); }
      .disc:active:not(:disabled) .pp { transform: scale(.9); }
      .controls .skip { height: 48px; padding: 0 16px; border-radius: 12px; font-size: 14px; gap: 6px; background: #1c1c1f; color: var(--text); }
      .controls .skip svg { width: 18px; height: 18px; }
      .load { margin-left: auto; width: 48px; height: 48px; flex: none; display: grid; place-items: center; border-radius: 12px; background: #1c1c1f; color: var(--text); cursor: pointer; }
      .load svg { width: 20px; height: 20px; }
      .load input { display: none; }
      .load:active { background: #26262a; }

      /* ---------- Master BPM ---------- */
      .center { position: relative; padding: 16px 16px 14px; border-radius: 22px; display: grid; gap: 6px; background: var(--card); border: 1px solid var(--line); }
      .bpm-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
      .bpm-big { text-align: center; user-select: none; flex: 1; }
      .bpm-big b { display: block; font-size: 56px; font-weight: 700; letter-spacing: -2px; font-variant-numeric: tabular-nums; line-height: 1; color: #fff; }
      .bpm-big small { display: block; margin-top: 6px; font-size: 12px; letter-spacing: 4px; color: #8b8b93; }
      .nudge { width: 48px; height: 48px; flex: none; display: grid; place-items: center; border-radius: 12px; border: 0; background: #1c1c1f; color: var(--text); }
      .nudge svg { width: 18px; height: 18px; }
      .nudge:active { background: #26262a; }

      .fader { -webkit-appearance: none; appearance: none; width: 100%; height: 44px; background: transparent; margin: 0; touch-action: pan-y; }
      .fader::-webkit-slider-runnable-track { height: 3px; border-radius: 3px; background: linear-gradient(90deg, var(--a), #9b9ba3 50%, var(--b)); opacity: .9; }
      .fader::-moz-range-track { height: 3px; border-radius: 3px; background: linear-gradient(90deg, var(--a), #9b9ba3 50%, var(--b)); }
      .fader::-webkit-slider-thumb { -webkit-appearance: none; width: 26px; height: 40px; margin-top: -18.5px; border-radius: 7px;
        background: linear-gradient(180deg, #e4e4e7 0 47%, #18181b 47% 53%, #e4e4e7 53%); box-shadow: 0 4px 12px #000a; }
      .fader::-moz-range-thumb { width: 26px; height: 40px; border-radius: 7px; border: 0; background: linear-gradient(180deg, #e4e4e7 0 47%, #18181b 47% 53%, #e4e4e7 53%); }
      .ticks { display: flex; justify-content: space-between; font-size: 12px; color: #8b8b93; font-variant-numeric: tabular-nums; margin-top: -2px; }

      /* Guía: dónde queda el BPM original de cada deck */
      .fader-box { position: relative; padding-top: 18px; }
      .marks { position: absolute; left: 13px; right: 13px; top: 0; bottom: 0; pointer-events: none; }
      .mark { position: absolute; top: 0; bottom: 6px; width: 0; transform: translateX(-50%); }
      .mark::after { content: ''; position: absolute; left: -.5px; top: 15px; bottom: 6px; width: 1px; background: var(--c); }
      .mark em { position: absolute; top: 0; left: 50%; transform: translateX(-50%); font-style: normal; font-size: 10px; color: var(--c); letter-spacing: 1px; }
      .mark.a { --c: var(--a); } .mark.b { --c: var(--b); }
      .mark.near em { top: -12px; }
      .resets { display: flex; gap: 10px; margin-top: 6px; }
      .reset { --c: var(--a); flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 40px; border-radius: 12px; border: 0;
        background: color-mix(in srgb, var(--c) 7%, #131315); color: color-mix(in srgb, var(--c) 75%, #fff); font-size: 13px; letter-spacing: 1px; transition: background .2s; }
      .reset.b { --c: var(--b); }
      .reset svg { width: 15px; height: 15px; }
      .reset b { font-weight: 500; font-variant-numeric: tabular-nums; }
      .reset.on { background: color-mix(in srgb, var(--c) 20%, #131315); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 45%, transparent); }
      .reset:disabled { color: color-mix(in srgb, var(--c) 35%, #555); cursor: default; }

      /* ---------- Pantalla completa ---------- */
      main { min-height: 100vh; min-height: 100dvh; grid-template-rows: auto 1fr auto 1fr; }
      .deck { align-self: stretch; }

      .icon-btn { position: relative; width: 38px; height: 38px; flex: none; display: grid; place-items: center; border-radius: 12px; border: 0; background: #1c1c1f; color: var(--text); }
      .icon-btn:active { background: #26262a; }
      .icon-btn.sm { width: 34px; height: 34px; border-radius: 50%; font-size: 14px; }
      .icon-btn .dot { position: absolute; top: 6px; right: 6px; width: 7px; height: 7px; border-radius: 50%; background: var(--a); }

      /* Hoja de ajustes */
      .settings { gap: 14px; max-height: 88dvh; overflow-y: auto; overscroll-behavior: contain; }
      .grab { width: 40px; height: 5px; border-radius: 5px; background: #ffffff33; margin: -8px auto 0; }
      .grab, .sheet-head { touch-action: none; }
      .sheet-head { display: flex; align-items: center; justify-content: space-between; }
      .sheet-head b { font-size: 20px; }
      .group { border-radius: 18px; background: #ffffff08; border: 1px solid var(--line); overflow: hidden; }
      .opt { display: flex; align-items: center; gap: 12px; padding: 14px; width: 100%; background: none; border: 0; text-align: left; cursor: pointer; }
      .opt + .opt { border-top: 1px solid var(--line); }
      .opt .ico { width: 36px; height: 36px; flex: none; display: grid; place-items: center; border-radius: 10px; background: #ffffff10; font-size: 17px; }
      .opt .txt { flex: 1; min-width: 0; }
      .opt .txt b { display: block; font-size: 15px; }
      .opt .txt small { display: block; color: var(--muted); font-size: 12px; margin-top: 2px; line-height: 1.35; }
      .opt .chev { color: var(--muted); font-size: 24px; }
      .switch { -webkit-appearance: none; appearance: none; flex: none; width: 52px; height: 32px; border-radius: 999px; background: #ffffff26; position: relative; cursor: pointer; transition: background .2s; margin: 0; }
      .switch::after { content: ''; position: absolute; top: 3px; left: 3px; width: 26px; height: 26px; border-radius: 50%; background: #fff; box-shadow: 0 2px 6px #0007; transition: transform .2s; }
      .switch:checked { background: #fff; }
      .switch:checked::after { transform: translateX(20px); background: #111; }
      .install-card { display: flex; align-items: center; gap: 12px; padding: 14px; border-radius: 18px; border: 1px solid var(--line); background: var(--glass); text-align: left; }
      .install-card[hidden] { display: none; }
      .install-card img { width: 46px; height: 46px; border-radius: 12px; }
      .install-card span { flex: 1; min-width: 0; }
      .install-card b { display: block; font-size: 15px; }
      .install-card small { display: block; color: var(--muted); font-size: 12px; margin-top: 2px; }
      .install-card em { font-style: normal; font-weight: 800; font-size: 13px; padding: 8px 12px; border-radius: 999px; background: #fff; color: #000; }
      .danger-soft { background: #ff3d9a14; border: 1px solid #ff3d9a55; color: var(--b); }
      .ver { margin: 0; text-align: center; font-size: 11px; color: var(--muted); }

      /* Bienvenida */
      .welcome { position: fixed; inset: 0; z-index: 30; display: grid; place-items: center; padding: calc(20px + var(--safe-t)) 22px calc(20px + var(--safe-b)); background: #0b0b0cee; backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); overflow-y: auto; animation: fade .35s ease; }
      .welcome[hidden] { display: none; }
      @keyframes fade { from { opacity: 0; } }
      .w-inner { width: 100%; max-width: 400px; display: grid; gap: 14px; justify-items: center; text-align: center; }
      .w-logo { width: 104px; height: 104px; border-radius: 26px; box-shadow: 0 0 0 1px var(--line), 0 20px 50px #000a; animation: float 4s ease-in-out infinite; }
      @keyframes float { 50% { transform: translateY(-6px); } }
      .welcome h2 { margin: 4px 0 0; font-size: 34px; font-weight: 900; letter-spacing: -1px; }
      .welcome h2 span { color: var(--muted); font-weight: 700; }
      .w-sub { margin: -8px 0 6px; color: var(--muted); }
      .w-steps { list-style: none; margin: 0 0 6px; padding: 0; display: grid; gap: 10px; width: 100%; text-align: left; }
      .w-steps li { display: flex; gap: 12px; align-items: flex-start; padding: 12px; border-radius: 16px; background: #ffffff0a; border: 1px solid var(--line); }
      .w-steps i { width: 34px; height: 34px; flex: none; display: grid; place-items: center; border-radius: 10px; font-style: normal; font-weight: 800; background: #ffffff12; }
      .w-steps b { display: block; font-size: 14px; }
      .w-steps small { display: block; color: var(--muted); font-size: 12px; margin-top: 2px; line-height: 1.4; }
      .btn.primary { width: 100%; background: #fff; color: #000; }
      .btn.ghost { width: 100%; background: none; border: 1px solid var(--line); }
      .btn[hidden] { display: none; }

      .bar { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; align-items: center; }
      .opts { display: flex; flex-wrap: wrap; gap: 14px; font-size: 13px; color: var(--muted); }
      .opts label { display: flex; align-items: center; gap: 6px; cursor: pointer; }
      .opts input { width: 18px; height: 18px; accent-color: #fff; }
      .end { background: #ff3d9a1a; border: 1px solid #ff3d9a88; color: var(--b); }
      .help { font-size: 12px; color: var(--muted); text-align: center; margin: 0; line-height: 1.5; }

      /* ---------- Bottom sheets con sensación nativa (curva de iOS, igual que Vaul) ---------- */
      :root { --ios: cubic-bezier(.32, .72, 0, 1); }
      .modal { position: fixed; inset: 0; display: flex; align-items: flex-end; z-index: 10; visibility: hidden; pointer-events: none; transition: visibility 0s linear .5s; }
      .modal::before { content: ''; position: absolute; inset: 0; background: #000; opacity: 0; transition: opacity .5s var(--ios); }
      .modal.show { visibility: visible; pointer-events: auto; transition: none; }
      .modal.show::before { opacity: calc(.6 * var(--fade, 1)); }
      .modal.dragging::before { transition: none; }
      .sheet { position: relative; width: 100%; max-width: 560px; margin: 0 auto; background: #161617; border: 1px solid var(--line); border-bottom: 0; border-radius: 26px 26px 0 0;
        padding: 20px 16px calc(20px + var(--safe-b)); display: grid; gap: 10px; box-shadow: 0 -10px 40px #0008;
        transform: translate3d(0, 100%, 0); transition: transform .5s var(--ios); will-change: transform; touch-action: none; }
      .sheet::after { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 100vh; background: #161617; } /* fondo al estirar hacia arriba */
      .modal.show .sheet { transform: translate3d(0, var(--drag, 0px), 0); }
      .modal.dragging .sheet { transition: none; }
      .modal:not(.has-grab) .sheet::before { content: ''; width: 40px; height: 5px; border-radius: 5px; background: #ffffff33; margin: -8px auto 2px; }

      /* La app de fondo se achica como en iOS */
      main, .aurora { transition: transform .5s var(--ios), filter .5s var(--ios), border-radius .5s var(--ios); }
      body.sheet-open main { transform: scale(calc(1 - .06 * var(--fade, 1))) translateY(calc(10px * var(--fade, 1))); filter: brightness(calc(1 - .35 * var(--fade, 1))); border-radius: 22px; overflow: hidden; }
      body.sheet-dragging main { transition: none; }
      .sheet p { margin: 0 0 8px; color: var(--muted); line-height: 1.5; }
      .steps { margin: 0; padding-left: 20px; color: var(--muted); line-height: 1.8; }
      .steps b { color: var(--text); }
      .btn { padding: 14px; border-radius: 14px; border: 0; font-weight: 700; font-size: 16px; background: var(--glass2); }
      .btn.danger { background: var(--b); color: #fff; }
      .toast { position: fixed; left: 50%; top: calc(14px + var(--safe-t)); transform: translateX(-50%); background: #1f1f21f0; border: 1px solid var(--line); padding: 10px 16px; border-radius: 999px; font-size: 14px; opacity: 0; transition: opacity .2s; pointer-events: none; z-index: 20; white-space: nowrap; }
      .toast.show { opacity: 1; }

      /* ---------- Solo vertical en móvil ---------- */
      .rotate { display: none; position: fixed; inset: 0; z-index: 50; background: var(--bg); place-items: center; text-align: center; padding: 24px; }
      .rotate div { display: grid; gap: 12px; justify-items: center; color: var(--muted); }
      .rotate b { font-size: 46px; color: var(--text); display: inline-block; animation: tilt 1.6s ease-in-out infinite; }
      @keyframes tilt { 0%, 30% { transform: rotate(90deg); } 60%, 100% { transform: rotate(0); } }
      @media (orientation: landscape) and (max-height: 520px) and (pointer: coarse) {
        .rotate { display: grid; }
        main { display: none; }
      }

      /* ---------- Celulares angostos ---------- */
      @media (max-width: 380px) {
        main { padding-left: 12px; padding-right: 12px; gap: 10px; }
        .deck { padding: 14px; }
        .deck-head { gap: 14px; }
        .disc { width: 68px; }
          .controls .skip, .load { height: 44px; }
        .load { width: 44px; }
        .bpm-big b { font-size: 50px; }
        .nudge { width: 44px; height: 44px; }
      }
      @media (max-width: 340px) {
        .disc { width: 56px; }
        .deck-id { letter-spacing: 2px; }
          .controls { gap: 6px; }
        .bpm-big b { font-size: 42px; }
        .reset { font-size: 12px; gap: 5px; }
      }
      /* ---------- Pantallas bajitas (≤ 740px): todo cabe sin scroll ---------- */
      @media (max-height: 740px) {
        main { gap: 8px; padding-top: calc(10px + var(--safe-t)); padding-bottom: calc(10px + var(--safe-b)); }
        header h1 { font-size: 19px; }
        .icon-btn { width: 34px; height: 34px; }
        .deck { padding: 12px 14px; gap: 6px; }
        header { padding-top: 0; }
        .disc { width: 62px; }
        .song b { font-size: 15px; }
        .song small { font-size: 12px; margin-top: 1px; }
        .meta { gap: 2px; }
        .prog { height: 14px; }
        .time { font-size: 11px; margin-top: -2px; }
        .controls { margin-top: 0; }
        .controls .skip, .load { height: 40px; }
        .load { width: 40px; }
        .center { padding: 12px 14px; gap: 2px; }
        .bpm-big b { font-size: 42px; }
        .bpm-big small { margin-top: 4px; font-size: 11px; }
        .nudge { width: 40px; height: 40px; }
        .fader { height: 38px; }
        .fader-box { padding-top: 14px; }
        .ticks { font-size: 11px; }
        .resets { margin-top: 6px; }
        .reset { height: 38px; }
      }
      @media (max-height: 600px) {
        main { gap: 6px; }
        header h1 { font-size: 17px; }
        .icon-btn { width: 30px; height: 30px; }
        .disc { width: 48px; }
        .song small, .shift { display: none; }
        .prog { height: 10px; }
        .controls .skip, .load { height: 36px; }
        .load { width: 36px; }
        .bpm-big b { font-size: 34px; }
        .bpm-big small { margin-top: 2px; font-size: 10px; }
        .nudge { width: 36px; height: 36px; }
        .fader { height: 32px; }
        .ticks { display: none; }
        .reset { height: 32px; }
      }
    </style>
  </head>
  <body>
    <div class="aurora" aria-hidden="true"></div>
