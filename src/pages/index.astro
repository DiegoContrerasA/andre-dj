    <!-- Bienvenida (primera vez) / guía -->
    <div class="welcome" id="welcome" hidden>
      <div class="w-inner">
        <img class="w-logo" src="/icon-512.png" alt="" />
        <h2>Andre's <span>DJ</span></h2>
