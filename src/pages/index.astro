          <button class="reset b mono" data-reset="b" disabled aria-label="Volver al BPM original del deck B"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 0 2.5-5.8M4 4v4.5h4.5"/></svg>B <b>—</b></button>
