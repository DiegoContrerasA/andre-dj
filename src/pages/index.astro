      </div>
    </div>
    <div class="modal" id="iosModal">
      <div class="sheet">
        <b>Instalar Andre's DJ</b>
        <ol class="steps">
          <li>Toca <b>Compartir</b> <span aria-hidden="true">⬆︎</span> en la barra de Safari</li>
          <li>Elige <b>Agregar a pantalla de inicio</b></li>
          <li>Toca <b>Agregar</b></li>
        </ol>
        <button class="btn" id="iosClose">Entendido</button>
      </div>
    </div>
    <div class="toast" id="toast"></div>

    <script>
      type DeckId = 'a' | 'b';
      type Song = { id: DeckId; title: string; artist: string; bpm: number | null; blob: Blob; name?: string };
      type Deck = {
        id: DeckId; el: HTMLElement; audio: HTMLAudioElement; song: Song | null; url: string | null;
        f: (name: string) => HTMLElement;
      };

      const PLAY_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M7 4.5v15l12-7.5z"/></svg>';
      const PAUSE_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8.5 5v14M15.5 5v14"/></svg>';
      const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
      const fader = $<HTMLInputElement>('fader');
      let toastTimer: number | undefined;
      const toast = (msg: string) => {
        const t = $('toast'); t.textContent = msg; t.classList.add('show');
        clearTimeout(toastTimer); toastTimer = window.setTimeout(() => t.classList.remove('show'), 2200);
      };
      const fmt = (t: number) => (isFinite(t) && t >= 0 ? `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, '0')}` : '0:00');
      const ls = {
        get: (k: string, d: any) => { try { return JSON.parse(localStorage.getItem(k)!) ?? d; } catch { return d; } },
        set: (k: string, v: any) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} },
      };

      // ---------- Nombres de archivo ----------
      const JUNK = /\b(forhub|klickaud|soundcloud|to\s*mp3|mp3\s*download|y2mate|savefrom|ytmp3|official\s*(video|audio)|lyrics?|hq|320\s*kbps)\b|\((official[^)]*|audio|video|lyric[^)]*)\)/gi;
      const tidy = (t: string) => (t || '').replace(/_/g, ' ').replace(JUNK, ' ').replace(/\s*-\s*$/, '').replace(/\s+/g, ' ').trim();
      const parseName = (file: string) => {
        const base = tidy(file.replace(/(\.[a-z0-9]{2,4})+$/i, ''));
        const m = base.match(/\[(\d{2,3}(?:\.\d+)?)\]|(\d{2,3}(?:\.\d+)?)\s*bpm/i);
        const clean = base.replace(/\[\d+(?:\.\d+)?\]|\d+(?:\.\d+)?\s*bpm/gi, '').replace(/\s+/g, ' ').trim();
        const sep = clean.indexOf(' - ');
        const [artist, title] = sep > 0 ? [clean.slice(0, sep), clean.slice(sep + 3)] : ['', clean];
        return { title, artist, bpm: m ? Number(m[1] ?? m[2]) : null };
      };

      // ---------- IndexedDB: una canción por deck (ids 'a' y 'b') ----------
      const STORE = 'session';
      let dbPromise: Promise<IDBDatabase> | null = null;
      const openDb = () => (dbPromise ??= new Promise<IDBDatabase>((res, rej) => {
        const r = indexedDB.open('bpm-player', 1);
        r.onupgradeneeded = () => r.result.createObjectStore(STORE, { keyPath: 'id' });
        r.onsuccess = () => { r.result.onclose = () => (dbPromise = null); res(r.result); };
        r.onerror = () => { dbPromise = null; rej(r.error); };
      }));
      const tx = async <T,>(mode: IDBTransactionMode, fn: (s: IDBObjectStore) => IDBRequest<T>) => {
        const db = await openDb();
        return new Promise<T>((res, rej) => {
          const req = fn(db.transaction(STORE, mode).objectStore(STORE));
          req.onsuccess = () => res(req.result);
          req.onerror = () => rej(req.error);
        });
      };
      const dbAll = () => tx<any[]>('readonly', (s) => s.getAll());
      const dbPut = (song: Song) => tx('readwrite', (s) => s.put(song));
      const dbDel = (id: string) => tx('readwrite', (s) => s.delete(id));
      const dbClear = () => tx('readwrite', (s) => s.clear());

      // ---------- Tempo compartido ----------
      // velocidad de cada deck = BPM compartido / BPM base del deck.
      // BPM base = el real si llega a 107–180 con ≤16% de ajuste; si no, su doble o mitad (como Rekordbox/Serato).
      const MIN_BPM = 107, MAX_BPM = 180;
      const clampBpm = (b: number) => Math.min(MAX_BPM, Math.max(MIN_BPM, b));
      const distToRange = (b: number) => (b < MIN_BPM ? Math.log(MIN_BPM / b) : b > MAX_BPM ? Math.log(b / MAX_BPM) : 0);
      const inRange = (b: number) => b >= MIN_BPM && b <= MAX_BPM;
      // BPM base: 1) el original o su doble/mitad si cae en 107–180 (así "Original" = velocidad 1.0)
      // 2) si ninguno cae (ej. 95: 47.5/95/190), el original si está a ≤16%, o el candidato más cercano.
      const baseBpm = (orig: number) => {
        const inside = [orig, orig * 2, orig / 2].find(inRange);
        if (inside) return inside;
        if (distToRange(orig) <= Math.log(1.16)) return orig;
        return [orig * 2, orig / 2].reduce((best, c) => (distToRange(c) < distToRange(best) ? c : best), orig);
      };
      let shared: number | null = ls.get('sharedBpm', null);

      // ---------- Decks ----------
      const mkDeck = (id: DeckId): Deck => {
        const el = $(`deck-${id}`);
        return { id, el, audio: el.querySelector('audio')!, song: null, url: null, f: (n) => el.querySelector(`[data-f="${n}"]`) as HTMLElement };
      };
      const decks: Record<DeckId, Deck> = { a: mkDeck('a'), b: mkDeck('b') };
      const other = (d: Deck) => (d.id === 'a' ? decks.b : decks.a);
      const playingDeck = () => (Object.values(decks).find((d) => !d.audio.paused) ?? null);
      let lastActive: Deck | null = null;

      function rateOf(d: Deck) {
        if (!d.song?.bpm || !shared) return 1;
        return shared / baseBpm(d.song.bpm);
      }

      function paintDeck(d: Deck) {
        const s = d.song;
        d.el.classList.toggle('empty', !s);
        d.f('title').textContent = s ? s.title : 'Sin canción';
        d.f('artist').textContent = s ? (s.artist || 'Sin artista') : 'Carga un archivo';
        d.f('bpmtag').innerHTML = s?.bpm ? `<b>${s.bpm}</b> bpm` : '— bpm';
        (d.el.querySelector('.play') as HTMLButtonElement).disabled = !s;
        const sh = d.f('shift');
        const label = sh.querySelector('span')!;
        if (!s) { sh.className = 'shift'; label.textContent = '—'; return; }
        if (!s.bpm) { sh.className = 'shift'; label.textContent = analyzing.has(s) ? 'Detectando BPM…' : 'BPM no detectado'; return; }
        const base = baseBpm(s.bpm);
        const pct = (rateOf(d) - 1) * 100;
        const a = Math.abs(pct);
        sh.className = 'shift ' + (a <= 8 ? 'ok' : a <= 16 ? 'mid' : 'bad');
        sh.title = a <= 8 ? 'Natural' : a <= 16 ? 'Se nota un poco' : 'Puede sonar distorsionado';
        label.textContent = `${pct > 0 ? '+' : ''}${pct.toFixed(1)}%${base !== s.bpm ? (base > s.bpm ? ' ·×2' : ' ·÷2') : ''}`;
      }

      function applyTempo() {
        const anyBpm = Object.values(decks).find((d) => d.song?.bpm);
        if (shared == null) shared = anyBpm ? baseBpm(anyBpm.song!.bpm!) : 128;
        shared = Math.round(clampBpm(shared) * 10) / 10;
        fader.disabled = false;
        fader.value = String(shared);
        ls.set('sharedBpm', shared);
        $('bpmOut').textContent = shared.toFixed(1);
        paintGuide();
        for (const d of Object.values(decks)) {
          const r = rateOf(d);
          d.audio.playbackRate = r;
          d.el.style.setProperty('--spin', `${(1.8 / r).toFixed(3)}s`);
          paintDeck(d);
        }
        syncMediaSession();
      }
      const setShared = (bpm: number) => { shared = bpm; applyTempo(); };

      // ---------- Guía de originales (marcas A/B sobre el fader + botones de volver) ----------
      const posPct = (bpm: number) => ((clampBpm(bpm) - MIN_BPM) / (MAX_BPM - MIN_BPM)) * 100;
      function paintGuide() {
        const bases: Partial<Record<DeckId, number>> = {};
        for (const d of Object.values(decks)) {
          const mark = document.querySelector<HTMLElement>(`[data-mark="${d.id}"]`)!;
          const btn = document.querySelector<HTMLButtonElement>(`[data-reset="${d.id}"]`)!;
          const raw = d.song?.bpm ? baseBpm(d.song.bpm) : null;
          const base = raw ? Math.round(clampBpm(raw) * 10) / 10 : null;
          const reachable = !!raw && inRange(raw);
          mark.hidden = !base; btn.disabled = !base;
          btn.querySelector('b')!.textContent = base ? `${reachable ? '' : '≈'}${base.toFixed(1)}` : '—';
          btn.title = base && !reachable ? `El original (${raw!.toFixed(1)}) está fuera de 107–180; este es el punto más cercano` : '';
          btn.classList.toggle('on', !!base && shared === base);
          if (base) { mark.style.left = `${posPct(base)}%`; bases[d.id] = base; }
        }
        const near = bases.a != null && bases.b != null && Math.abs(posPct(bases.a) - posPct(bases.b)) < 7;
        document.querySelector('[data-mark="b"]')!.classList.toggle('near', near);
      }
      document.querySelectorAll<HTMLButtonElement>('[data-reset]').forEach((b) => b.addEventListener('click', () => {
        const d = decks[b.dataset.reset as DeckId];
        if (d.song?.bpm) { setShared(baseBpm(d.song.bpm)); navigator.vibrate?.(15); }
      }));
      // Imán: al arrastrar cerca (±0.8 BPM) del original de un deck, se pega a él
      const snap = (bpm: number) => {
        for (const d of Object.values(decks)) {
          if (!d.song?.bpm) continue;
          const base = Math.round(clampBpm(baseBpm(d.song.bpm)) * 10) / 10;
          if (Math.abs(bpm - base) <= 0.8) { if (shared !== base) navigator.vibrate?.(10); return base; }
        }
        return bpm;
      };

      // ---------- Detección automática de BPM ----------
      // Decodifica ~2 MB del medio del archivo (≈2 min a 128 kbps; no se carga el mix completo en memoria),
      // saca la envolvente de golpes de graves (bombo) y busca la periodicidad con autocorrelación.
      const analyzing = new WeakSet<Song>();
      // ---- MP3: encontrar el inicio de un frame real (Safari/iOS no decodifica un pedazo que empieza a mitad de frame) ----
      const MP3_BR = { 1: [0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320], 2: [0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160] };
      const MP3_SR: Record<number, number[]> = { 3: [44100, 48000, 32000], 2: [22050, 24000, 16000], 0: [11025, 12000, 8000] };
      // Largo en bytes del frame MPEG Layer III que empieza en i, o 0 si no es una cabecera válida
      const mp3FrameLen = (u: Uint8Array, i: number) => {
        if (i + 4 > u.length || u[i] !== 0xff || (u[i + 1] & 0xe0) !== 0xe0) return 0;
        const ver = (u[i + 1] >> 3) & 3, layer = (u[i + 1] >> 1) & 3;
        const bri = (u[i + 2] >> 4) & 15, sri = (u[i + 2] >> 2) & 3, pad = (u[i + 2] >> 1) & 1;
        if (ver === 1 || layer !== 1 || bri === 0 || bri === 15 || sri === 3) return 0;
        const br = MP3_BR[ver === 3 ? 1 : 2][bri] * 1000, sr = MP3_SR[ver][sri];
        return Math.floor(((ver === 3 ? 144 : 72) * br) / sr) + pad;
      };
      // Primer offset con 3 frames seguidos válidos (evita falsos positivos dentro de los datos)
      const findMp3Sync = (u: Uint8Array, from = 0) => {
        for (let i = from; i < u.length - 4; i++) {
          const l1 = mp3FrameLen(u, i); if (!l1) continue;
          const l2 = mp3FrameLen(u, i + l1); if (!l2) continue;
          if (mp3FrameLen(u, i + l1 + l2)) return i;
        }
        return -1;
      };
      // ¿Es MP3? Se mira el contenido, no el nombre/tipo (en móvil a veces llegan vacíos o como video/mpeg)
      async function sniffMp3(blob: Blob) {
        const head = new Uint8Array(await blob.slice(0, 64 * 1024).arrayBuffer());
        if (head[0] === 0x49 && head[1] === 0x44 && head[2] === 0x33) return true; // etiqueta ID3
        return findMp3Sync(head) >= 0;
      }
      const decode = (bytes: ArrayBuffer) => new Promise<AudioBuffer>((res, rej) => {
        const Ctx = window.OfflineAudioContext || (window as any).webkitOfflineAudioContext;
        if (!Ctx) return rej(new Error('Web Audio no disponible'));
        // 22050 Hz: la mitad de memoria que 44.1 kHz y de sobra para detectar el bombo
        const p = new Ctx(1, 1, 22050).decodeAudioData(bytes, res, rej);
        (p as any)?.catch?.(rej);
      });

      async function detectBpm(blob: Blob): Promise<number | null> {
        // Se decodifican como mucho ~2.5 MB (≈2.5 min de MP3): cabe en la memoria de cualquier celular
        const CHUNK = 2_500_000;
        let audioBuf: AudioBuffer | null = null;
        let lastErr: unknown = null;
        if (await sniffMp3(blob)) {
          // Intentos: un pedazo del medio (el ritmo suele estar asentado) y, si falla, el inicio del archivo
          const starts = blob.size > CHUNK * 1.5 ? [Math.floor(blob.size * 0.4), 0] : [0];
          for (const start of starts) {
            try {
              const raw = new Uint8Array(await blob.slice(start, start + CHUNK).arrayBuffer());
              const sync = start === 0 ? 0 : findMp3Sync(raw);
              if (sync < 0) throw new Error('No se encontró audio MP3 en el pedazo');
              audioBuf = await decode(raw.slice(sync).buffer);
              break;
            } catch (e) { lastErr = e; }
          }
        } else if (blob.size <= 40_000_000) {
          // M4A/WAV/FLAC/OGG necesitan el archivo completo (cabeceras); hasta 40 MB para no agotar la memoria del celular
          try { audioBuf = await decode(await blob.arrayBuffer()); } catch (e) { lastErr = e; }
        } else {
          throw new Error('Archivo muy grande para analizar en este formato');
        }
        if (!audioBuf) throw lastErr ?? new Error('No se pudo leer el audio');
        const sr = audioBuf.sampleRate;
        // Analizar como máximo 120 s (desde el 40% si el audio es más largo)
        const maxLen = Math.floor(sr * 120);
        const off = audioBuf.length > maxLen ? Math.floor(audioBuf.length * 0.4) : 0;
        const len = Math.min(maxLen, audioBuf.length - off);
        const ch0 = audioBuf.getChannelData(0).subarray(off, off + len);
        const ch1 = audioBuf.numberOfChannels > 1 ? audioBuf.getChannelData(1).subarray(off, off + len) : ch0;
        const hop = sr >= 44100 ? 512 : 256, fps = sr / hop; // ~86 cuadros/s sea cual sea la frecuencia
        const a = 1 - Math.exp((-2 * Math.PI * 150) / sr); // pasa-bajos ~150 Hz
        let lp = 0;
        const nFrames = Math.floor(ch0.length / hop);
        const low = new Float32Array(nFrames), full = new Float32Array(nFrames);
        for (let f = 0; f < nFrames; f++) {
          let el = 0, ef = 0;
          for (let i = f * hop, e = i + hop; i < e; i++) {
            const x = (ch0[i] + ch1[i]) * 0.5;
            lp += a * (x - lp);
            el += lp * lp; ef += x * x;
          }
          low[f] = Math.log1p(el * 1000); full[f] = Math.log1p(ef * 100);
        }
        // Flujo de energía (solo subidas) = probabilidad de golpe
        const onset = new Float32Array(nFrames);
        let mean = 0;
        for (let f = 1; f < nFrames; f++) { onset[f] = Math.max(0, low[f] - low[f - 1]) + 0.5 * Math.max(0, full[f] - full[f - 1]); mean += onset[f]; }
        mean /= nFrames;
        for (let f = 0; f < nFrames; f++) onset[f] = Math.max(0, onset[f] - mean);
        // Autocorrelación entre 60 y 200 BPM con preferencia suave alrededor de 120
        const ac = (lag: number) => { let sum = 0; for (let i = lag; i < nFrames; i++) sum += onset[i] * onset[i - lag]; return sum / (nFrames - lag); };
        const minLag = Math.floor((60 * fps) / 200), maxLag = Math.ceil((60 * fps) / 60);
        const acs: number[] = [];
        if (2 * maxLag + 1 >= nFrames) return null; // muy poco audio
        for (let l = 0; l <= 2 * maxLag + 1; l++) acs[l] = l >= minLag - 1 ? ac(l) : 0; // incluye 2·lag para el armónico
        let best = -1, bestScore = -Infinity;
        for (let l = minLag; l <= maxLag; l++) {
          const bpm = (60 * fps) / l;
          const w = Math.exp(-0.5 * Math.pow(Math.log2(bpm / 120) / 0.9, 2));
          const score = (acs[l] + 0.5 * acs[2 * l]) * w;
          if (score > bestScore) { bestScore = score; best = l; }
        }
        if (best < 0 || bestScore <= 0) return null;
        // Interpolación parabólica para precisión decimal
        const y0 = acs[best - 1], y1 = acs[best], y2 = acs[best + 1];
        const den = y0 - 2 * y1 + y2;
        const lag = best + (den ? (0.5 * (y0 - y2)) / den : 0);
        return Math.round(((60 * fps) / lag) * 10) / 10;
      }
      async function autoBpm(d: Deck) {
        const song = d.song;
        if (!song || song.bpm || analyzing.has(song)) return;
        analyzing.add(song); paintDeck(d);
        try {
          const raw = await detectBpm(song.blob);
          // La autocorrelación no distingue bien entre mitad/doble: se reporta la octava que cae en 107–180 si existe
          const bpm = raw ? Math.round(([raw, raw * 2, raw / 2].find(inRange) ?? raw) * 10) / 10 : null;
          if (bpm && !song.bpm) {
            song.bpm = bpm;
            dbPut(song).catch(() => {});
            if (d.song === song) toast(`Deck ${d.id.toUpperCase()}: ${bpm} BPM detectado`);
          }
          else if (!raw && d.song === song) toast(`Deck ${d.id.toUpperCase()}: no se encontró un ritmo claro`);
        } catch (e: any) {
          // El deck suena a velocidad normal; se muestra el motivo para poder diagnosticar
          console.warn('[BPM] detección falló', e);
          if (d.song === song) toast(`Deck ${d.id.toUpperCase()}: no se pudo detectar el BPM (${e?.name && e.name !== 'Error' ? e.name : e?.message || 'error'})`);
        }
        analyzing.delete(song);
        if (d.song === song) applyTempo();
      }

      function setSong(d: Deck, song: Song | null) {
        d.audio.pause();
        if (d.url) { URL.revokeObjectURL(d.url); d.url = null; }
        d.song = song;
        if (song) { d.url = URL.createObjectURL(song.blob); d.audio.src = d.url; }
        else { d.audio.removeAttribute('src'); d.audio.load(); }
        d.f('cur').textContent = '0:00'; d.f('rem').textContent = '-0:00';
        d.f('prog').style.setProperty('--p', '0%');
        applyTempo();
      }

      async function toggle(d: Deck) {
        if (!d.song) return;
        if (d.audio.paused) {
          other(d).audio.pause(); // solo suena un deck a la vez
          d.audio.playbackRate = rateOf(d);
          try { await d.audio.play(); } catch {}
        } else d.audio.pause();
      }

      for (const d of Object.values(decks)) {
        const { audio } = d;
        d.el.querySelectorAll('[data-act="toggle"]').forEach((b) => b.addEventListener('click', () => toggle(d)));

        // Cargar archivo (reemplaza la canción del deck)
        const file = d.f('file') as HTMLInputElement;
        file.addEventListener('change', async () => {
          const f = file.files?.[0];
          file.value = '';
          if (!f) return;
          const song: Song = { id: d.id, name: f.name, blob: f, ...parseName(f.name) };
          setSong(d, song);
          if (!song.bpm) autoBpm(d);
          try { await dbPut(song); navigator.storage?.persist?.(); toast(`Deck ${d.id.toUpperCase()} cargado`); }
          catch { toast('Suena, pero no se pudo guardar en el celular'); }
        });

        // Estado visual
        const sync = () => {
          d.el.classList.toggle('playing', !audio.paused);
          (d.el.querySelector('.play .pp') as HTMLElement).innerHTML = audio.paused ? PLAY_ICON : PAUSE_ICON;
        };
        const live = () => document.body.classList.toggle('live', !!playingDeck());
        audio.addEventListener('play', () => { lastActive = d; sync(); live(); syncMediaSession(); });
        audio.addEventListener('pause', () => { sync(); live(); syncMediaSession(); });
        audio.addEventListener('ended', sync);
        audio.addEventListener('loadedmetadata', () => { audio.playbackRate = rateOf(d); tick(); });
        const tick = () => {
          const dur = audio.duration;
          d.f('cur').textContent = fmt(audio.currentTime);
          d.f('rem').textContent = `-${fmt((dur || 0) - audio.currentTime)}`;
          if (!scrubbing) d.f('prog').style.setProperty('--p', dur ? `${(audio.currentTime / dur) * 100}%` : '0%');
        };
        audio.addEventListener('timeupdate', tick);

        // Barra de progreso: tocar o arrastrar para moverse
        const prog = d.f('prog');
        let scrubbing = false;
        const at = (e: PointerEvent) => { const r = prog.getBoundingClientRect(); return Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)); };
        prog.addEventListener('pointerdown', (e) => { if (!audio.duration) return; scrubbing = true; prog.setPointerCapture(e.pointerId); prog.style.setProperty('--p', `${at(e) * 100}%`); });
        prog.addEventListener('pointermove', (e) => { if (scrubbing) prog.style.setProperty('--p', `${at(e) * 100}%`); });
        prog.addEventListener('pointerup', (e) => { if (!scrubbing) return; scrubbing = false; audio.currentTime = at(e) * audio.duration; });
        prog.addEventListener('pointercancel', () => { scrubbing = false; tick(); });

        // Adelantar / retroceder 10 s: botones y doble toque a la izquierda/derecha de la tarjeta
        let fxTimer: number | undefined, fxSum = 0, fxDir = 0;
        const skip = (secs: number) => {
          if (!d.song || !audio.duration) return;
          audio.currentTime = Math.min(audio.duration - 0.25, Math.max(0, audio.currentTime + secs));
          tick();
          const fx = d.f('fx');
          fxSum = Math.sign(secs) === fxDir ? fxSum + secs : secs; fxDir = Math.sign(secs);
          fx.textContent = `${fxSum > 0 ? '+' : '−'}${Math.abs(fxSum)} s`;
          fx.className = `seek-fx mono show ${secs < 0 ? 'l' : 'r'}`;
          clearTimeout(fxTimer);
          fxTimer = window.setTimeout(() => { fx.classList.remove('show'); fxSum = 0; fxDir = 0; }, 650);
          navigator.vibrate?.(6);
        };
        d.el.querySelectorAll<HTMLButtonElement>('[data-skip]').forEach((b) => b.addEventListener('click', () => skip(+b.dataset.skip!)));
        let lastUp = 0, lastX = 0;
        d.el.addEventListener('pointerup', (e) => {
          if ((e.target as HTMLElement).closest('button, input, label, .prog')) return; // no en controles
          const now = e.timeStamp;
          const r = d.el.getBoundingClientRect();
          const side = e.clientX - r.left < r.width / 2 ? -10 : 10;
          if (now - lastUp < 320 && Math.abs(e.clientX - lastX) < 60) { skip(side); lastUp = now - 160; } // toques seguidos acumulan
          else lastUp = now;
          lastX = e.clientX;
        });

      }

      // ---------- Controles del BPM compartido ----------
      fader.addEventListener('input', () => setShared(snap(+fader.value)));
      const nudge = (dir: number) => setShared((shared ?? 128) + dir * 0.5);
      for (const [id, dir] of [['plus', 1], ['minus', -1]] as const) {
        const b = $(id);
        let timer: number | undefined, rep: number | undefined;
        const end = () => { clearTimeout(timer); clearInterval(rep); };
        b.addEventListener('pointerdown', (e) => {
          e.preventDefault(); nudge(dir); navigator.vibrate?.(8);
          timer = window.setTimeout(() => (rep = window.setInterval(() => nudge(dir), 80)), 400);
        });
        ['pointerup', 'pointerleave', 'pointercancel'].forEach((ev) => b.addEventListener(ev, end));
      }
      // Doble toque en el número: vuelve al BPM original del deck que suena (o el último usado)
      let lastTap = 0;
      $('bigBpm').addEventListener('click', () => {
        const now = Date.now();
        const d = playingDeck() ?? lastActive;
        if (now - lastTap < 350 && d?.song?.bpm) { setShared(baseBpm(d.song.bpm)); navigator.vibrate?.(15); toast(`BPM original del deck ${d.id.toUpperCase()}`); }
        lastTap = now;
      });

      // ---------- Mantener tono ----------
      const lock = $<HTMLInputElement>('lock');
      const applyLock = () => Object.values(decks).forEach(({ audio }) => { audio.preservesPitch = lock.checked; (audio as any).webkitPreservesPitch = lock.checked; });
      lock.onchange = applyLock;
      applyLock();

      // ---------- Terminar sesión ----------
      $('end').onclick = () => { closeSheet('settings'); setTimeout(() => openSheet('modal'), 180); };
      $('cancelEnd').onclick = () => closeSheet('modal');
      $('confirmEnd').onclick = async () => {
        await dbClear();
        setSong(decks.a, null); setSong(decks.b, null);
        shared = null; localStorage.removeItem('sharedBpm');
        applyTempo();
        closeSheet('modal');
        toast('Sesión terminada. Todo borrado.');
      };

      // ---------- Pantalla bloqueada: controles del sistema ----------
      function syncMediaSession() {
        if (!('mediaSession' in navigator)) return;
        const ms = navigator.mediaSession;
        const d = playingDeck() ?? lastActive;
        ms.playbackState = playingDeck() ? 'playing' : 'paused';
        if (!d?.song) return;
        ms.metadata = new MediaMetadata({
          title: d.song.title, artist: `Deck ${d.id.toUpperCase()}${shared ? ` · ${shared.toFixed(1)} BPM` : ''}`, album: "Andre's DJ",
          artwork: [{ src: '/icon-512.png', sizes: '512x512', type: 'image/png' }],
        });
        if (d.audio.duration && isFinite(d.audio.duration)) {
          try { ms.setPositionState({ duration: d.audio.duration, position: Math.min(d.audio.currentTime, d.audio.duration), playbackRate: d.audio.playbackRate || 1 }); } catch {}
        }
      }
      if ('mediaSession' in navigator) {
        const cur = () => playingDeck() ?? lastActive ?? (decks.a.song ? decks.a : decks.b);
        const handlers: [MediaSessionAction, MediaSessionActionHandler][] = [
          ['play', () => { const d = cur(); if (d?.audio.paused) toggle(d); }],
          ['pause', () => playingDeck()?.audio.pause()],
          ['nexttrack', () => { const d = cur(); if (d && other(d).song) toggle(other(d)); }],     // cambia al otro deck
          ['previoustrack', () => { const d = cur(); if (d && other(d).song) toggle(other(d)); }],
          ['seekbackward', (e) => { const d = cur(); if (d) d.audio.currentTime -= e.seekOffset ?? 10; }],
          ['seekforward', (e) => { const d = cur(); if (d) d.audio.currentTime += e.seekOffset ?? 10; }],
          ['seekto', (e) => { const d = cur(); if (d && e.seekTime != null) d.audio.currentTime = e.seekTime; }],
        ];
        for (const [a, h] of handlers) { try { navigator.mediaSession.setActionHandler(a, h); } catch {} }
      }

      // Mantener pantalla encendida (Wake Lock)
      const wake = $<HTMLInputElement>('wake');
      let wakeLock: any = null;
      if ('wakeLock' in navigator) {
        $('wakeRow').hidden = false;
        wake.checked = ls.get('wake', false);
        const requestWake = async () => {
          if (!wake.checked || document.visibilityState !== 'visible') return;
          try { wakeLock = await (navigator as any).wakeLock.request('screen'); } catch {}
        };
        wake.onchange = async () => { ls.set('wake', wake.checked); if (wake.checked) requestWake(); else { await wakeLock?.release(); wakeLock = null; } };
        document.addEventListener('visibilitychange', requestWake);
        requestWake();
      }

      // ---------- Ajustes (hoja) ----------
      function openSheet(id: string) {
        const m = $(id);
        m.style.removeProperty('--drag'); m.style.removeProperty('--fade'); document.body.style.removeProperty('--fade');
        m.classList.add('show'); document.body.classList.add('sheet-open');
        navigator.vibrate?.(6);
      }
      function closeSheet(id: string) {
        const m = $(id);
        m.style.removeProperty('--drag'); m.style.removeProperty('--fade'); document.body.style.removeProperty('--fade');
        m.classList.remove('show');
        if (!document.querySelector('.modal.show')) document.body.classList.remove('sheet-open');
      }
      // Arrastrar para cerrar: se sigue el dedo, se cierra por distancia (>25%) o por velocidad (swipe rápido)
      document.querySelectorAll<HTMLElement>('.modal').forEach((m) => {
        const sheet = m.querySelector<HTMLElement>('.sheet')!;
        m.addEventListener('click', (e) => { if (e.target === m) closeSheet(m.id); }); // tocar afuera
        let startY = 0, lastY = 0, lastT = 0, vel = 0, dragging = false, pending = false, h = 1;
        const set = (dy: number) => {
          const y = dy < 0 ? -Math.pow(-dy, 0.6) : dy; // hacia arriba cede poco (elástico)
          m.style.setProperty('--drag', `${y}px`);
          const fade = Math.max(0, 1 - Math.max(0, dy) / h);
          m.style.setProperty('--fade', String(fade)); document.body.style.setProperty('--fade', String(fade));
        };
        // Si el contenido no cabe (pantallas muy bajitas), se permite scroll y se arrastra desde la cabecera
        const fit = () => { sheet.style.touchAction = sheet.scrollHeight > sheet.clientHeight + 1 ? 'pan-y' : 'none'; };
        new MutationObserver(fit).observe(m, { attributes: true, attributeFilter: ['class'] });
        sheet.addEventListener('pointerdown', (e) => {
          if (e.button > 0) return;
          // si el contenido está desplazado, primero se hace scroll normal
          if (sheet.scrollTop > 0) return;
          startY = lastY = e.clientY; lastT = e.timeStamp; vel = 0; pending = true; h = sheet.offsetHeight;
        });
        sheet.addEventListener('pointermove', (e) => {
          if (!pending && !dragging) return;
          const dy = e.clientY - startY;
          if (pending) {
            if (Math.abs(dy) < 6) return;            // umbral: un toque no es arrastre
            pending = false; dragging = true;
            sheet.setPointerCapture(e.pointerId);
            m.classList.add('dragging'); document.body.classList.add('sheet-dragging');
          }
          const dt = Math.max(1, e.timeStamp - lastT);
          vel = 0.8 * ((e.clientY - lastY) / dt) + 0.2 * vel; // px/ms suavizado
          lastY = e.clientY; lastT = e.timeStamp;
          set(dy);
        });
        const end = (e: PointerEvent) => {
          pending = false;
          if (!dragging) return;
          dragging = false;
          m.classList.remove('dragging'); document.body.classList.remove('sheet-dragging');
          const dy = e.clientY - startY;
          if (dy > h * 0.25 || vel > 0.45) { navigator.vibrate?.(4); closeSheet(m.id); }
          else { m.style.removeProperty('--drag'); m.style.removeProperty('--fade'); document.body.style.removeProperty('--fade'); }
        };
        sheet.addEventListener('pointerup', end);
        sheet.addEventListener('pointercancel', end);
      });
      $('openSettings').onclick = () => openSheet('settings');
      $('settings').addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-close]')) closeSheet('settings'); });

      // ---------- Bienvenida ----------
      const welcome = $('welcome');
      if (!ls.get('welcomed', false)) welcome.hidden = false;
      $('startApp').onclick = () => { welcome.hidden = true; ls.set('welcomed', true); };
      $('openGuide').onclick = () => { closeSheet('settings'); welcome.hidden = false; };

      // ---------- Instalar ----------
      const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;
      const isIos = /iphone|ipad|ipod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      let installEvt: any = null;
      const installEls = [...document.querySelectorAll<HTMLElement>('[data-install]')];
      const showInstall = (on: boolean) => { installEls.forEach((el) => (el.hidden = !on)); $('settingsDot').hidden = !on; };
      if (!standalone) {
        window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); installEvt = e; showInstall(true); });
        if (isIos) showInstall(true);
      }
      installEls.forEach((el) => el.addEventListener('click', async () => {
        if (installEvt) { installEvt.prompt(); const r = await installEvt.userChoice; installEvt = null; if (r?.outcome === 'accepted') showInstall(false); }
        else if (isIos) { closeSheet('settings'); openSheet('iosModal'); }
      }));
      $('iosClose').onclick = () => closeSheet('iosModal');
      window.addEventListener('appinstalled', () => { showInstall(false); toast("Andre's DJ instalada"); });
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') navigator.serviceWorker.register('/sw.js').catch(() => {});

      // ---------- Solo vertical (Android instalada; en iOS/navegador se muestra aviso por CSS) ----------
      const lockPortrait = () => (screen.orientation as any)?.lock?.('portrait').catch(() => {});
      lockPortrait();
      document.addEventListener('fullscreenchange', lockPortrait);

      // ---------- Inicio: recuperar decks guardados ----------
      // Migra canciones de la versión anterior (lista) a los decks A y B.
      (async () => {
        try {
          let rows = await dbAll();
          const legacy = rows.filter((r) => r.id !== 'a' && r.id !== 'b').sort((x, y) => (x.addedAt ?? 0) - (y.addedAt ?? 0));
          for (const r of legacy) {
            const free = (['a', 'b'] as DeckId[]).find((id) => !rows.some((x) => x.id === id));
            await dbDel(r.id);
            if (free) { const moved = { ...r, id: free }; delete moved.addedAt; await dbPut(moved); rows.push(moved); }
          }
          rows = rows.filter((r) => r.id === 'a' || r.id === 'b');
          for (const r of rows) {
            const d = decks[r.id as DeckId];
            setSong(d, { ...r, title: tidy(r.title), artist: tidy(r.artist) });
            if (!r.bpm) autoBpm(d);
          }
        } catch { toast('En este navegador las canciones no quedan guardadas'); }
        applyTempo();
      })();
    </script>
  </body>
</html>
