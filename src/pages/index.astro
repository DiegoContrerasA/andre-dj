      <div class="deck b empty" id="deck-b">
        <div class="deck-head">
          <button class="disc play" data-act="toggle" disabled aria-label="Play/pausa deck B"><span class="vinyl"></span><span class="pp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M7 4.5v15l12-7.5z"/></svg></span></button>
