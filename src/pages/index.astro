---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Deck from '../components/Deck.astro';
import MasterBpm from '../components/MasterBpm.astro';
import SettingsSheet from '../components/SettingsSheet.astro';
import Welcome from '../components/Welcome.astro';
import Dialogs from '../components/Dialogs.astro';
---
<Layout>
  <!-- Solo vertical en móvil -->
  <div class="fixed inset-0 z-50 hidden place-items-center bg-bg p-6 text-center landscape-phone:grid">
    <div class="grid justify-items-center gap-3 text-muted">
      <b class="inline-block animate-tilt text-[46px] text-ink">📱</b>Gira el teléfono a vertical
    </div>
  </div>

  <main
    class="app mx-auto grid min-h-dvh max-w-[560px] grid-rows-[auto_1fr_auto_1fr] gap-3 px-4 pt-[calc(16px+var(--safe-t))] pb-[calc(16px+var(--safe-b))] landscape-phone:hidden narrow:gap-2.5 narrow:px-3 short:gap-2 short:pt-[calc(10px+var(--safe-t))] short:pb-[calc(10px+var(--safe-b))] tiny:gap-1.5"
  >
    <Header />
    <Deck id="a" />
    <MasterBpm />
    <Deck id="b" />
  </main>

  <SettingsSheet />
  <Welcome />
  <Dialogs />

  <div
    class="pointer-events-none fixed top-[calc(14px+var(--safe-t))] left-1/2 z-20 -translate-x-1/2 rounded-full border border-line bg-[#1f1f21f0] px-4 py-2.5 text-sm whitespace-nowrap opacity-0 transition-opacity duration-200 data-show:opacity-100"
    id="toast"
  ></div>

  <script>
    import '../scripts/app';
  </script>
</Layout>
