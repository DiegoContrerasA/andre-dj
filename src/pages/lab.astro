---
// Laboratorio de motores de audio: compara <audio> con Tone.Player / PitchShift / GrainPlayer.
// Página aparte: Tone.js solo se descarga aquí, la app principal no cambia.
import Layout from '../layouts/Layout.astro';

const card = 'grid gap-3 rounded-[22px] border border-line bg-card p-4';
const lbl = 'font-mono text-[11px] tracking-[2px] text-muted';
const sel = 'h-11 w-full rounded-xl border border-line bg-btn px-3 text-[15px] text-ink';
const seg = 'grid grid-cols-2 gap-2 [&_label]:flex [&_label]:min-h-11 [&_label]:cursor-pointer [&_label]:items-center [&_label]:justify-center [&_label]:rounded-xl [&_label]:bg-btn [&_label]:px-2 [&_label]:text-center [&_label]:text-[13px] [&_label]:font-semibold [&_label:has(:checked)]:bg-white [&_label:has(:checked)]:text-black [&_input]:hidden';
const row = 'flex items-center justify-between gap-3 text-sm';
const range = 'w-full accent-white';
---
<Layout title="Andre's DJ · Lab">
  <main class="mx-auto grid max-w-[560px] gap-3 px-4 pt-[calc(16px+var(--safe-t))] pb-[calc(24px+var(--safe-b))]">
    <header class="flex items-center justify-between">
      <a href="/" class="btn-dark h-10 px-3.5 text-sm">‹ App</a>
      <b class="font-mono text-sm tracking-[3px]">AUDIO LAB</b>
      <span class="w-[64px]"></span>
    </header>

    <!-- 1. Canción y motor -->
    <section class={card}>
      <span class={lbl}>CANCIÓN</span>
      <div class="grid grid-cols-[1fr_auto] gap-2">
        <select id="src" class={sel}><option value="">Cargando decks…</option></select>
        <label class="btn-dark h-11 cursor-pointer px-3.5 text-sm">Archivo<input type="file" id="file" class="hidden" accept="audio/*,.mp3,.m4a,.wav,.aac,.flac,.ogg" /></label>
      </div>

      <span class={lbl}>MOTOR</span>
      <div class={seg} id="engines">
        <label><input type="radio" name="eng" value="audio" checked />&lt;audio&gt; (actual)</label>
        <label><input type="radio" name="eng" value="grain" />Tone.GrainPlayer</label>
        <label><input type="radio" name="eng" value="player" />Tone.Player</label>
        <label><input type="radio" name="eng" value="player-ps" />Player + PitchShift</label>
      </div>
      <p id="engNote" class="m-0 text-xs leading-[1.4] text-muted"></p>
    </section>

    <!-- 2. Contexto de audio (solo Tone) -->
    <section class={card} id="ctxCard">
      <span class={lbl}>CONTEXTO WEB AUDIO</span>
      <div class="grid grid-cols-2 gap-2">
        <label class="grid gap-1 text-xs text-muted">Latencia
          <select id="latency" class={sel}>
            <option value="playback" selected>playback (más estable)</option>
            <option value="balanced">balanced</option>
            <option value="interactive">interactive (Tone por defecto)</option>
          </select>
        </label>
        <label class="grid gap-1 text-xs text-muted">lookAhead
          <select id="lookAhead" class={sel}>
            <option value="0.05">50 ms</option>
            <option value="0.1">100 ms (defecto)</option>
            <option value="0.2" selected>200 ms (más estable)</option>
            <option value="0.3">300 ms</option>
          </select>
        </label>
      </div>
      <button id="unlock" class="btn bg-white text-black">Activar audio</button>
      <p class="m-0 text-xs leading-[1.4] text-muted">iOS solo deja arrancar Web Audio con un toque. Cambiar latencia o lookAhead recrea el contexto (vuelve a tocar el botón).</p>

      <div id="grainTune" class="grid gap-2" hidden>
        <div class={row}><span>Tamaño de grano</span><output id="gsOut" class="font-mono"></output></div>
        <input type="range" id="grainSize" class={range} min="0.04" max="0.4" step="0.01" value="0.12" />
        <div class={row}><span>Overlap (fundido entre granos)</span><output id="ovOut" class="font-mono"></output></div>
        <input type="range" id="overlap" class={range} min="0.01" max="0.2" step="0.005" value="0.06" />
      </div>
      <div id="psTune" class="grid gap-2" hidden>
        <div class={row}><span>Ventana del PitchShift</span><output id="wsOut" class="font-mono"></output></div>
        <input type="range" id="windowSize" class={range} min="0.03" max="0.25" step="0.005" value="0.1" />
      </div>
    </section>

    <!-- 3. Reproducción -->
    <section class={card}>
      <div class="flex min-w-0 items-baseline justify-between gap-2">
        <b id="title" class="truncate text-[17px]">Sin canción</b>
        <span id="baseBpm" class="flex-none font-mono text-xs text-muted">— bpm</span>
      </div>
      <div class="prog relative grid h-[18px] cursor-pointer touch-none items-center" id="prog" style="--c: var(--color-a)"><i></i></div>
      <div class="-mt-1 flex justify-between font-mono text-xs text-muted tabular-nums"><span id="cur">0:00</span><span id="rem">-0:00</span></div>
      <div class="grid grid-cols-3 gap-2">
        <button class="btn-dark h-12 text-sm" data-skip="-10">−10 s</button>
        <button class="btn bg-white text-black" id="pp" disabled>Play</button>
        <button class="btn-dark h-12 text-sm" data-skip="10">+10 s</button>
      </div>

      <div class={row}><span class={lbl}>BPM</span><b id="bpmOut" class="font-mono text-2xl tabular-nums">128.0</b></div>
      <input type="range" class="fader" id="fader" min="107" max="180" step="0.1" value="128" />
      <div class="flex items-center justify-between font-mono text-xs text-muted"><span id="rateOut">1.000×</span><span id="pendingOut"></span></div>

      <label class={row}><span>Aplicar BPM al soltar</span><input type="checkbox" class="switch" id="onRelease" checked /></label>
      <label class={row}><span>Mantener tono</span><input type="checkbox" class="switch" id="lock" checked /></label>
    </section>

    <!-- 4. Métricas -->
    <section class={card}>
      <span class={lbl}>MÉTRICAS</span>
      <dl id="stats" class="m-0 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 font-mono text-xs [&_dd]:m-0 [&_dd]:text-right [&_dd]:text-ink [&_dt]:text-muted"></dl>
      <button id="resetStats" class="btn-dark h-10 text-sm">Reiniciar métricas</button>
    </section>
  </main>

  <script>
    import '../scripts/lab/lab';
  </script>
</Layout>
